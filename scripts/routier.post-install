#!/bin/sh
set -eu

install -dm700 /var/lib/routier
install -dm700 /var/lib/routier/snapshots

live=
[ -e /run/openrc/softlevel ] && live=1

password=
if ! id routier >/dev/null 2>&1; then
	adduser -D -s /bin/ash -h /home/routier routier
	for grp in root wheel; do
		addgroup routier "$grp" 2>/dev/null || true
	done

	if [ -n "$live" ]; then
		password=$(openssl rand -base64 18 | tr -d '/+=' | cut -c1-16)
		printf 'routier:%s\n' "$password" | chpasswd >/dev/null
		(umask 077 && printf '%s\n' "$password" > /var/lib/routier/ui-seed-password)
	fi
fi

if [ ! -f /var/lib/routier/tls.key ]; then
	(umask 077 && openssl ecparam -genkey -name prime256v1 -noout \
		-out /var/lib/routier/tls.key) 2>/dev/null \
	&& openssl req -new -x509 \
		-key /var/lib/routier/tls.key \
		-out /var/lib/routier/tls.crt \
		-days 3650 \
		-subj "/CN=$(hostname 2>/dev/null || echo routier)" 2>/dev/null || true
fi

if [ -x /usr/bin/routier ]; then
	/usr/bin/routier version > /etc/routier/version 2>/dev/null || true
	/usr/bin/routier issue > /etc/issue 2>/dev/null || true
fi

[ -n "$live" ] || exit 0

urls=$(ip -4 -o addr show scope global 2>/dev/null | awk '{ split($4, a, "/"); printf "  https://%s:8080\n", a[1] }')

printf '\nroutier installed. Networking is unchanged until you apply and confirm a configuration.\n\n'
printf 'Web UI:\n%s\n' "${urls:-  https://<host>:8080}"
if [ -n "$password" ]; then
	printf '\nLogin: routier / %s\n(one-time password, changed at first login)\n\n' "$password"
else
	printf '\nLogin: routier with its existing password\n\n'
fi
